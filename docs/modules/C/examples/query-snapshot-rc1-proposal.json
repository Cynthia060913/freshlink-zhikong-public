      "body": {
        "detail": {
          "reason_code": "snapshot_capacity",
          "message": "Try again after active snapshots expire."
        }
      }
    }
  ],
  "concurrent_commit_vector": {
    "T1": "Insert X with server received_at earlier than the first-page watermark; keep T1 uncommitted.",
    "S": "In one short consistent transaction, persist the ordered immutable observation/version membership visible to S; exclude X.",
    "after": "Commit T1; S page/total/CSV still exclude X, while a new first-page snapshot may include X."
  },
  "resource_limit_proposal": {
    "ttl_seconds": 900,
    "max_members_per_snapshot": 10000,
    "max_active_per_actor": 4,
    "max_active_global": 64,
    "capacity_error": "429 snapshot_capacity; Retry-After:30; never silently evict a live snapshot"
  },
  "limitations": [
