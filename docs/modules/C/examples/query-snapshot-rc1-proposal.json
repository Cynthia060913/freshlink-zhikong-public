  "error_examples": [
    {
      "id": "missing_snapshot",
      "target_http_status": 422,
      "body": {
        "detail": {
          "reason_code": "snapshot_required",
          "message": "Start a new query and export with its snapshot_id."
        }
      }
    },
    {
      "id": "expired_or_cross_actor_snapshot",
      "target_http_status": 422,
      "body": {
        "detail": {
          "reason_code": "invalid_snapshot",
          "message": "Restart from the first page."
        }
      }
    },
    {
      "id": "over_10000_snapshot_members",
      "target_http_status": 422,
      "body": {
        "detail": {
          "reason_code": "snapshot_row_limit",
          "message": "Narrow the filters to at most 10000 rows."
        }
      }
    },
    {
      "id": "capacity_exhausted_proposal",
      "target_http_status": 429,
      "headers": {
        "Retry-After": "30"
