  "export_request": {
    "method": "GET",
    "path": "/api/v1/telemetry/observations/export.csv",
    "filters": {
      "warehouse_id": "22222222-2222-4222-8222-222222222222",
      "device_id": "11111111-1111-4111-8111-111111111111",
