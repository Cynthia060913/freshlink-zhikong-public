* text=auto
*.sh text eol=lf
# Keep frontend formatter checks consistent across Windows and Linux clones.
frontend/** text=auto eol=lf
# Schema evidence hashes and editable figure sources must survive Windows clones.
docs/submission/design/*.json text eol=lf
docs/submission/design/*.tex text eol=lf
docs/submission/design/*.pdf binary
docs/submission/design/*.png binary

# Material index hashes use literal checkout bytes on Windows and Linux.
docs/submission/claude-final-materials/*.md text eol=lf
docs/submission/claude-final-materials/*.tex text eol=lf
docs/submission/claude-final-materials/*.py text eol=lf
docs/submission/claude-final-materials/*.mjs text eol=lf
docs/submission/claude-final-materials/*.json text eol=lf
docs/submission/claude-final-materials/*.html text eol=lf
